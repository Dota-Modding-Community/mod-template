{
  "name": "Template Mod (Feature Reference)",
  "author": "Your Name / Organization",
  "description": "Comprehensive template and reference guide for Dota 2 Minify mods.",
  "version": "1.0.0",
  "category": "other",
  "settings": [
    {
      "key": "hide_hud_decorations",
      "text": "Hide HUD Decorations",
      "type": "checkbox",
      "default": true
    },
    {
      "key": "hide_minimap",
      "text": "Hide Minimap Elements",
      "type": "checkbox",
      "default": false
    },
    {
      "key": "theme_name",
      "text": "UI Theme Variant",
      "type": "combo",
      "items": ["dark", "light", "minimal"],
      "default": "dark"
    },
    {
      "key": "custom_title",
      "text": "Custom Title Text",
      "type": "inputbox",
      "default": "Minify Enhanced HUD"
    },
    {
      "key": "accent_color",
      "text": "Glow / Accent Color",
      "type": "color",
      "default": "#00FFCC"
    },
    {
      "key": "hud_opacity",
      "text": "HUD Opacity",
      "type": "slider",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.85
    },
    {
      "key": "custom_sound_pack",
      "text": "Custom Sound Pack Enabled",
      "type": "checkbox",
      "default": true
    },
    {
      "key": "run_custom_action",
      "text": "Run Custom Utility Action",
      "type": "button"
    }
  ]
}
